<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pruebas Ionic</title>
  </head>
  <body>
    <ion-app>
      <ion-header>
        <ion-toolbar color="primary">
          <ion-title>Ionic + Supabase</ion-title>
        </ion-toolbar>
      </ion-header>

      <ion-content class="ion-padding">
        <h2>Prueba Vanilla JS</h2>
        <ion-button id="btn-conectar">Consultar Supabase</ion-button>
        <pre id="resultado" style="margin-top: 16px; background: #eee; padding: 10px;"></pre>
      </ion-content>
    </ion-app>

    <script type="module" src="/main.js"></script>
  </body>
</html>